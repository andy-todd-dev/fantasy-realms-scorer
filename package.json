{
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "awilix": "^13.0.5",
    "expo": "^57.0.1",
    "expo-dev-client": "~57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0",
    "react-redux": "^9.3.1"
  },
  "name": "fantasy-realms-scorer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "preandroid": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:e2e": "sh scripts/with-metro.sh 'adb reverse tcp:8081 tcp:8081 && maestro test -e APP_BUILD=debug .maestro'",
    "test:e2e:build": "sh scripts/with-metro.sh 'EXPO_OFFLINE=1 expo run:android --no-bundler && npm run test:e2e'",
    "test:e2e:release": "maestro test -e APP_BUILD=release .maestro",
    "test:e2e:build:release": "EXPO_OFFLINE=1 expo run:android --variant release --no-bundler && npm run test:e2e:release"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "start-server-and-test": "^3.0.13",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|immer|redux|redux-thunk|reselect|@reduxjs/toolkit))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "main": "src/main.tsx"
}
